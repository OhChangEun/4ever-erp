{
  "name": "@everp/ui",
  "version": "0.1.0",
  "private": true,
  "description": "EverP 공통 UI 컴포넌트. 앱은 소스(TS)를 그대로 가져와 Next 가 변환한다(transpilePackages). 밖에 낼 때의 모양은 pnpm build(dist)",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./tokens.css"
  },
  "scripts": {
    "build": "vite build -c vite.lib.config.mts && tsc -p tsconfig.build.json && cp tokens.css dist/tokens.css",
    "check:lib": "node scripts/check-lib.mjs",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --quiet"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.16"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.4",
    "@storybook/react-vite": "10.6.4",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "4.14.0",
    "jsdom": "^31.0.0",
    "remixicon": "4.9.1",
    "storybook": "10.6.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/index.js"
      },
      "./tokens.css": "./dist/tokens.css"
    }
  }
}
