{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "//#lint": {
      "inputs": ["$TURBO_DEFAULT$", "!.next/**", "!coverage/**", "!test-results/**"]
    },
    "//#type-check": {
      "inputs": ["$TURBO_DEFAULT$", "!.next/**", "!coverage/**", "!test-results/**"]
    },
    "//#test:run": {
      "inputs": ["$TURBO_DEFAULT$", "!.next/**", "!coverage/**", "!test-results/**"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "build-storybook": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["storybook-static/**"]
    },
    "build": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"]
    },
    "check:lib": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "type-check": {
      "inputs": ["$TURBO_DEFAULT$", "!.next/**"]
    }
  }
}
