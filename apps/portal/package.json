  },
  "dependencies": {
    "@everp/auth": "workspace:*",
    "next": "^16.1.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
