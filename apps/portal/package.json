{
  "name": "@everp/portal",
  "version": "0.1.0",
  "private": true,
  "description": "공급사와 고객사용 얇은 포털(SSO 포털 카드). erp 와 같은 Keycloak realm 으로 SSO, 같은 @everp/auth 를 쓴다. 로컬 전용(포트 3300)",
  "scripts": {
    "dev": "next dev --port 3300",
